{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex.invalid/apple-reminders/eventkit-bridge-request-v1.schema.json",
  "title": "Apple Reminders EventKit bridge request",
  "type": "object",
  "required": ["schema_version", "operation"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "operation": {
      "enum": [
        "schema",
        "capabilities",
        "doctor",
        "request_access",
        "list_accounts",
        "list_calendars",
        "fetch_reminders",
        "read_reminder",
        "create_reminder",
        "update_reminder",
        "complete_reminder",
        "reopen_reminder",
        "move_reminder"
      ]
    },
    "source_id": {"type": "string", "minLength": 1},
    "writable_only": {"type": "boolean"},
    "reminder_id": {"type": "string", "minLength": 1},
    "calendar_id": {"type": "string", "minLength": 1},
    "calendar_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"enum": ["incomplete", "completed", "any"]},
    "query": {"type": "string", "minLength": 1, "maxLength": 500},
    "due_start": {"$ref": "#/$defs/rfc3339"},
    "due_end": {"$ref": "#/$defs/rfc3339"},
    "completion_start": {"$ref": "#/$defs/rfc3339"},
    "completion_end": {"$ref": "#/$defs/rfc3339"},
    "modified_after": {"$ref": "#/$defs/rfc3339"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "offset": {"type": "integer", "minimum": 0, "maximum": 10000},
    "sort": {"enum": ["due", "modified", "title"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 10000},
    "notes": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"], "format": "uri"},
    "location": {"type": ["string", "null"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 9},
    "due": {"oneOf": [{"$ref": "#/$defs/due"}, {"type": "null"}]},
    "alarms": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/alarm"}
        }
      ]
    },
    "recurrence_rules": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 1,
          "items": {"$ref": "#/$defs/recurrence"}
        }
      ]
    },
    "patch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 10000},
        "notes": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "location": {"type": ["string", "null"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 9},
        "due": {"oneOf": [{"$ref": "#/$defs/due"}, {"type": "null"}]},
        "alarms": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/alarm"}}
          ]
        },
        "recurrence_rules": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/recurrence"}}
          ]
        }
      }
    },
    "expected_last_modified": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with Z or an explicit UTC offset."
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "date"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "all_day"},
            "date": {"type": "string", "format": "date"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "date_time", "time_zone"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "timed"},
            "date_time": {"$ref": "#/$defs/rfc3339"},
            "time_zone": {
              "type": "string",
              "description": "IANA time-zone name such as Asia/Seoul."
            }
          }
        }
      ]
    },
    "alarm": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "date_time"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "absolute"},
            "date_time": {"$ref": "#/$defs/rfc3339"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "proximity", "location"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "location"},
            "proximity": {"enum": ["enter", "leave"]},
            "location": {
              "type": "object",
              "required": ["title", "latitude", "longitude"],
              "additionalProperties": false,
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "latitude": {"type": "number", "minimum": -90, "maximum": 90},
                "longitude": {"type": "number", "minimum": -180, "maximum": 180},
                "radius_meters": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000}
              }
            }
          }
        }
      ]
    },
    "weekday": {
      "type": "object",
      "required": ["day"],
      "additionalProperties": false,
      "properties": {
        "day": {
          "enum": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"]
        },
        "ordinal": {
          "type": "integer",
          "minimum": -53,
          "maximum": 53,
          "not": {"const": 0}
        }
      }
    },
    "recurrence": {
      "type": "object",
      "required": ["frequency", "interval"],
      "additionalProperties": false,
      "properties": {
        "frequency": {"enum": ["daily", "weekly", "monthly", "yearly"]},
        "interval": {"type": "integer", "minimum": 1, "maximum": 999},
        "days_of_week": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/weekday"}
        },
        "days_of_month": {
          "type": "array",
          "minItems": 1,
          "maxItems": 62,
          "items": {"type": "integer", "minimum": -31, "maximum": 31, "not": {"const": 0}}
        },
        "months_of_year": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "integer", "minimum": 1, "maximum": 12}
        },
        "weeks_of_year": {
          "type": "array",
          "minItems": 1,
          "maxItems": 106,
          "items": {"type": "integer", "minimum": -53, "maximum": 53, "not": {"const": 0}}
        },
        "days_of_year": {
          "type": "array",
          "minItems": 1,
          "maxItems": 732,
          "items": {"type": "integer", "minimum": -366, "maximum": 366, "not": {"const": 0}}
        },
        "set_positions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 732,
          "items": {"type": "integer", "minimum": -366, "maximum": 366, "not": {"const": 0}}
        },
        "end": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "count"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "count"},
                "count": {"type": "integer", "minimum": 1, "maximum": 10000}
              }
            },
            {
              "type": "object",
              "required": ["kind", "date_time"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "date"},
                "date_time": {"$ref": "#/$defs/rfc3339"}
              }
            }
          ]
        }
      }
    }
  },
  "x-operation-required-fields": {
    "list_calendars": [],
    "fetch_reminders": ["limit"],
    "read_reminder": ["reminder_id"],
    "create_reminder": ["calendar_id", "title"],
    "update_reminder": ["reminder_id", "expected_last_modified", "patch"],
    "complete_reminder": ["reminder_id", "expected_last_modified"],
    "reopen_reminder": ["reminder_id", "expected_last_modified"],
    "move_reminder": ["reminder_id", "expected_last_modified", "calendar_id"]
  },
  "x-response-statuses": [
    "unchanged",
    "verified",
    "committed_verification_pending",
    "partial_success",
    "failed_no_mutation"
  ],
  "x-error-codes": [
    "ambiguous_scope",
    "ambiguous_target",
    "concurrent_modification",
    "invalid_input",
    "permission_denied",
    "schema_mismatch",
    "sync_pending",
    "unsupported_capability",
    "unexpected_error"
  ],
  "x-mutation-receipt": {
    "backend": "eventkit_public_sdk",
    "base_required": [
      "ok",
      "status",
      "operation",
      "operation_id",
      "backend",
      "target",
      "after",
      "verification",
      "recovery"
    ],
    "before_required_except": ["create_reminder"],
    "warnings_required_for": ["committed_verification_pending"]
  }
}
