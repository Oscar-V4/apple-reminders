                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "required": [
                  "kind",
                  "count"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "date"
                  },
                  "date_time": {
                    "type": "string",
                    "format": "date-time",
                    "minLength": 20,
                    "maxLength": 64
                  }
                },
                "required": [
                  "kind",
                  "date_time"
                ],
                "additionalProperties": false
              }
            ]
          },
          "recurrence": {
            "type": "object",
            "properties": {
              "frequency": {
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "yearly"
                ]
              },
              "interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "days_of_week": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/weekday"
                }
              },
              "days_of_month": {
                "type": "array",
                "minItems": 1,
                "maxItems": 62,
