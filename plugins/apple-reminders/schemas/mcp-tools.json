        "additionalProperties": false,
        "$defs": {
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "due": {
            "oneOf": [
              {
                "type": "object",
