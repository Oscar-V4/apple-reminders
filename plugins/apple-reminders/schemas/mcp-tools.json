{
  "schemaVersion": 2,
  "tools": [
    {
      "name": "request_reminders_access",
      "description": "Explicitly request full macOS Reminders access through EventKit. This may display the system permission prompt but does not read or change Reminder content.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_reminder_lists",
      "description": "List a bounded set of Apple Reminder Lists through EventKit, including exact account identity so duplicate display names remain distinguishable.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "writable_only": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 100
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "fetch_reminders",
      "description": "Fetch one semantically bounded page of Reminders through EventKit. Incomplete reads require list_ids or a due range of at most 366 days; completed reads always require a completion range of at most 90 days. Cursors are opaque and bound to the original filters, sort, and page size.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "status": {
            "enum": [
              "incomplete",
              "completed"
            ],
            "default": "incomplete"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "due_start": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 64
          },
          "due_end": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 64
          },
          "completion_start": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 64
          },
          "completion_end": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 64
          },
          "modified_after": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 64
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 100
          },
          "sort": {
            "enum": [
              "due",
              "modified",
              "title"
            ],
            "default": "due"
          },
          "cursor": {
            "$ref": "#/$defs/cursor"
          }
        },
        "oneOf": [
          {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            },
            "anyOf": [
              {
                "required": [
                  "list_ids"
                ]
              },
              {
                "required": [
                  "due_start",
                  "due_end"
                ]
              }
            ]
          },
          {
            "required": [
              "status",
              "completion_start",
              "completion_end"
            ],
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          }
        ],
        "x-rangeConstraints": [
          {
            "start": "due_start",
            "end": "due_end",
            "maximumDays": 366
          },
          {
            "start": "completion_start",
            "end": "completion_end",
            "maximumDays": 90
          }
        ],
        "additionalProperties": false,
        "$defs": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read_reminder",
      "description": "Read one exact Reminder and return its full Core projection plus one opaque rev1 Reference for guarded changes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reminder_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "reminder_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "create_reminder",
      "description": "Create one Reminder in an exact writable Reminder List. Typed due dates, alarms, recurrence, URL visibility, and create idempotency retain their existing behavior.",
