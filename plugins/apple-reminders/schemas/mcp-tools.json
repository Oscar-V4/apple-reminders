                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "timed"
                  },
                  "date_time": {
                    "type": "string",
                    "format": "date-time",
                    "minLength": 20,
                    "maxLength": 64
                  },
                  "time_zone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
