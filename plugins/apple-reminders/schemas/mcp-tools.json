            "minLength": 1,
            "maxLength": 100000
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "due": {
            "$ref": "#/$defs/due"
          },
          "alarms": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/alarm"
            }
          },
          "recurrence_rules": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/recurrence"
            }
          },
          "idempotency_key": {
            "$ref": "#/$defs/idempotency_key"
          }
        },
        "required": [
          "list_id",
          "title",
          "idempotency_key"
