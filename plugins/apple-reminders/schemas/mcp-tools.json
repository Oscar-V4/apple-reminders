              "day": {
                "enum": [
                  "sunday",
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday"
                ]
              },
              "ordinal": {
                "type": "integer",
                "minimum": -53,
                "maximum": 53,
                "not": {
                  "const": 0
                }
              }
            },
            "required": [
              "day"
            ],
            "additionalProperties": false
          },
          "recurrence_end": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "count"
