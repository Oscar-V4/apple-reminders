                  "maximum": 31,
                  "not": {
                    "const": 0
                  }
                }
              },
              "months_of_year": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                }
              },
              "weeks_of_year": {
                "type": "array",
                "minItems": 1,
                "maxItems": 106,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": -53,
                  "maximum": 53,
                  "not": {
                    "const": 0
                  }
                }
              },
              "days_of_year": {
                "type": "array",
                "minItems": 1,
                "maxItems": 732,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": -366,
                  "maximum": 366,
                  "not": {
                    "const": 0
                  }
                }
              },
              "set_positions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 732,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": -366,
                  "maximum": 366,
                  "not": {
                    "const": 0
                  }
                }
              },
              "end": {
                "$ref": "#/$defs/recurrence_end"
              }
            },
            "required": [
              "frequency",
              "interval"
            ],
            "additionalProperties": false
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
